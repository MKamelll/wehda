<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PDF Export</title>
    <style>
      @page {
        size: {{ page_size }};
        margin: 20mm;
        @top-right {
          content: element(MultiLineHeader);
          vertical-align: bottom;
          padding-bottom: 10px;
        }
      }

      .header-container {
        position: running(MultiLineHeader);
        direction: rtl;
        text-align: right;
        font-family: "Arial", sans-serif;
        line-height: 1.4;
      }

      body {
        font-family: "Arial", sans-serif;
        font-size: 10pt;
        font-weight: bold;
        direction: rtl;
        text-align: right;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
      }

      th, td {
        border: 1px solid #999999;
        padding: 8px;
        text-align: right;
      }

      th {
        background-color: #f2f2f2;
      }

      h2 {
        text-align: center;
      }

      .header {
        font-size: 12pt; 
        font-weight: bold;
        color: #111111;
      }

      .phone-col {
        direction: ltr !important;
        text-align: right !important;
        unicode-bidi: embed;
      }

      .empty {
        text-align: center;
      }

    </style>
  </head>
  <body>
    <div class="header-container">
      <div class="header">الإدارة الصحية ب{{ health_admin }}</div>
      <div class="header">وحدة {{ unit_name }} الصحية</div>
    </div>
    <h2>قـــوة وحـــدة طـــب الأســــرة ب{{ unit_name }}</h2>
    <table>
      <thead>
        <tr>
          {% for header in headers %}<th>{{ header }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for employee in employees %}
          <tr>
            <td>{{ employee.name }}</td>
            <td>{{ employee.get_job_title_display }}</td>
            <td>{{ employee.current_grade_short }}</td>
            <td>{{ employee.national_id }}</td>
            <td class="phone-col">{{ employee.phone_number }}</td>
            {% for i in empty_cols %}<td></td>{% endfor %}
          </tr>
        {% empty %}
          <tr>
            <td colspan="3" class="empty">لم يتم اختيار أي بيانات</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </body>
</html>
